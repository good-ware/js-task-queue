{
  "name": "@goodware/task-queue",
  "version": "3.0.2",
  "description": "A lightweight task queue",
  "keywords": [
    "queue",
    "async",
    "concurrent"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "format": "prettier . --write",
    "prepare": "npm run build",
    "pub": "npm publish --access=public",
    "test": "npm run build && node dist/tests/index.js",
    "docs": "npm run build && node_modules/.bin/jsdoc --configure .jsdoc.json --verbose -R README.md dist/src/*.js"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./StoppedError": {
      "types": "./StoppedError.d.ts",
      "require": "./StoppedError.js",
      "default": "./StoppedError.js"
    }
  },
  "files": [
    "dist",
    "index.d.ts",
    "index.js",
    "StoppedError.d.ts",
    "StoppedError.js",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/good-ware/js-task-queue.git"
  },
  "license": "BSD-2-Clause",
  "devDependencies": {
    "eslint": "*",
    "eslint-config-airbnb-base": "*",
    "eslint-config-prettier": "*",
    "eslint-plugin-import": "*",
    "jsdoc": "*",
    "minami": "*",
    "prettier": "*",
    "typescript": "^5.8.3"
  }
}
